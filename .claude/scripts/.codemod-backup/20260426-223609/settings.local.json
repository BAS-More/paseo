      "mcp__avios-context-mcp__avios_save_session",
      "mcp__avios-context__avios_list_projects",
      "mcp__avios-context__avios_get_session_context",
      "mcp__avios-context__avios_get_project_state",
      "mcp__avios-context__avios_log_sprint_item",
      "mcp__avios-context__avios_add_decision",
      "mcp__avios-context__avios_save_session",
      "Bash(node \"C:/Dev/ezra-claude-code/bin/cli.js\" --global)",
