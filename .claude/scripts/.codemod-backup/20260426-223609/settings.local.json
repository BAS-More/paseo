{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Avi Bendetsky/.claude/hooks/ezra-dash-hook.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"C:/Users/Avi Bendetsky/.claude/hooks/ezra-session-sync.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Avi Bendetsky/.claude/hooks/ezra-guard.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"C:/Users/Avi Bendetsky/.claude/hooks/ezra-oversight.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Avi Bendetsky/.claude/hooks/ezra-tier-gate.js\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Avi Bendetsky/.claude/hooks/ezra-session-sync.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"C:/Users/Avi Bendetsky/.claude/hooks/ezra-progress-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Avi Bendetsky/.claude/hooks/ezra-progress-hook.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"C:/Users/Avi Bendetsky/.claude/hooks/ezra-drift-hook.js\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node \"C:/Users/Avi Bendetsky/.claude/hooks/ezra-avios-bridge.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"C:/Users/Avi Bendetsky/.claude/hooks/ezra-version-hook.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/Avi Bendetsky/.claude/hooks/ezra-memory-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
