    "model": "claude-sonnet-4-5-thinking",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$HOME/.claude/hooks/plan-gate.js\"",
                        "timeout": 5
                    },
                    {
                        "type": "command",
                        "command": "node \"$HOME/.claude/hooks/claude-config-guard.js\"",
                        "timeout": 3
                    },
                    {
                        "type": "command",
                        "command": "node \"$HOME/.claude/hooks/test-first-lock.js\"",
                        "timeout": 8
                    }
                ]
            },
            {
                "matcher": "Grep|Glob|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$HOME/.claude/hooks/knowledge-graph/knowledge-graph-hook.cjs\"",
                        "timeout": 10,
                        "statusMessage": "Enriching with Knowledge-Graph graph context..."
                    }
                ]
            },
            {
                "matcher": "Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
