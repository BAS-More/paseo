                        "timeout": 5
                    },
                    {
                        "type": "command",
                        "command": "node \"$HOME/.claude/hooks/rules-subrepo-reminder.js\"",
                        "timeout": 3
                    },
                    {
                        "type": "command",
                        "command": "node \"$HOME/.claude/hooks/lint-edited.js\"",
                        "timeout": 35
                    },
                    {
                        "type": "command",
                        "command": "node \"$HOME/.claude/hooks/stuck-detector.js\"",
                        "timeout": 5
                    }
